[gd_resource type="Theme" load_steps=4 format=3]

[sub_resource type="SystemFont" id="1"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "SimHei", "Noto Sans CJK SC", "sans-serif")

; 嵌入子窗口的边框。标题栏不是单独画的：样式盒先画在内容矩形上，再被内容纹理盖住，
; 只有 expand_margin 外扩出来的部分可见——向上外扩 32 即标题栏底色（须与 title_height 一致）。
[sub_resource type="StyleBoxFlat" id="sb_window_border"]
content_margin_left = 2.0
content_margin_top = 2.0
content_margin_right = 2.0
content_margin_bottom = 2.0
bg_color = Color(0.062, 0.086, 0.141, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.12)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
expand_margin_left = 3.0
expand_margin_top = 32.0
expand_margin_right = 3.0
expand_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="sb_window_border_unfocused"]
content_margin_left = 2.0
content_margin_top = 2.0
content_margin_right = 2.0
content_margin_bottom = 2.0
bg_color = Color(0.05, 0.068, 0.112, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.07)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
expand_margin_left = 3.0
expand_margin_top = 32.0
expand_margin_right = 3.0
expand_margin_bottom = 3.0

[resource]
default_font = SubResource("1")
default_font_size = 15
Window/colors/title_color = Color(0.92, 0.94, 0.98, 1)
Window/constants/title_height = 32
Window/constants/close_v_offset = 16
Window/font_sizes/title_font_size = 15
Window/fonts/title_font = SubResource("1")
Window/styles/embedded_border = SubResource("sb_window_border")
Window/styles/embedded_unfocused_border = SubResource("sb_window_border_unfocused")
