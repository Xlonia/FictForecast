[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/settings_editor.gd" id="1_editor"]
[ext_resource type="Theme" path="res://theme/main_theme.tres" id="2_theme"]

[node name="EditorRoot" type="Window"]
title = "设置编辑器 · 幻想气象局"
size = Vector2i(980, 680)
min_size = Vector2i(880, 600)
embedded = false
script = ExtResource("1_editor")

[node name="Root" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Tabs" type="TabContainer" parent="Root/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="WorldTab" type="VBoxContainer" parent="Root/Column/Tabs"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Top" type="HBoxContainer" parent="Root/Column/Tabs/WorldTab"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WorldPick" type="OptionButton" parent="Root/Column/Tabs/WorldTab/Top"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NewId" type="LineEdit" parent="Root/Column/Tabs/WorldTab/Top"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
placeholder_text = "新世界ID"

[node name="NewBtn" type="Button" parent="Root/Column/Tabs/WorldTab/Top"]
layout_mode = 2
text = "创建世界"

[node name="Form" type="VBoxContainer" parent="Root/Column/Tabs/WorldTab"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SeedRow" type="HBoxContainer" parent="Root/Column/Tabs/WorldTab/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SeedKey" type="Label" parent="Root/Column/Tabs/WorldTab/Form/SeedRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.62, 0.69, 0.8, 1)
text = "种子 seed（留空 = 按本地化键名派生）"

[node name="SeedEdit" type="LineEdit" parent="Root/Column/Tabs/WorldTab/Form/SeedRow"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2

[node name="TimeSection" type="VBoxContainer" parent="Root/Column/Tabs/WorldTab/Form"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Root/Column/Tabs/WorldTab/Form/TimeSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.69, 0.8, 1)
text = "基准时间 base_times —— 时区偏差（分钟），会投射到世界 0° 经度；城市 times 引用其 id，非法/留空 → UTC"

[node name="Rows" type="VBoxContainer" parent="Root/Column/Tabs/WorldTab/Form/TimeSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="AddBtn" type="Button" parent="Root/Column/Tabs/WorldTab/Form/TimeSection"]
layout_mode = 2
text = "＋ 添加基准时间"

[node name="DateSection" type="VBoxContainer" parent="Root/Column/Tabs/WorldTab/Form"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Root/Column/Tabs/WorldTab/Form/DateSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.69, 0.8, 1)
text = "基准日期 base_dates —— 与现实日期差（天）；城市 calendar 引用其 id，非法/留空 → 公历"

[node name="Rows" type="VBoxContainer" parent="Root/Column/Tabs/WorldTab/Form/DateSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="AddBtn" type="Button" parent="Root/Column/Tabs/WorldTab/Form/DateSection"]
layout_mode = 2
text = "＋ 添加基准日期"

